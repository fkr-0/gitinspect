{
  "name": "gitinspect-workspace",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome lint . --error-on-warnings",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "lint:fix": "biome lint --write .",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "test:coverage": "pnpm --filter @gitinspect/graph-elements test:coverage && pnpm --filter @gitinspect/app test:coverage",
    "release:metadata": "bash scripts/release-check.sh --candidate --metadata-only",
    "release:metadata-test": "bash scripts/release-metadata-self-test.sh",
    "release:package-audit-test": "node scripts/release-package-audit.mjs --self-test",
    "release:package-harness-test": "bash scripts/release-package-qualification.sh --self-test",
    "release:package-qualify": "bash scripts/release-package-qualification.sh",
    "release:verify": "bash scripts/release-check.sh --verify",
    "release:candidate": "bash scripts/release-check.sh --candidate",
    "release:native-gate-test": "bash scripts/native-release-qualification.sh --self-test",
    "release:native-authority-diagnostics": "bash scripts/native-release-authority-diagnostics.sh --self-test",
    "release:native-qualify": "bash scripts/native-release-qualification.sh",
    "check:single-r3f": "node scripts/check-single-r3f.mjs",
    "wasm:smoke": "node scripts/wasm-smoke.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "playwright-core": "1.60.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
